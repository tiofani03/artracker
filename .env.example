# copy to .env and adjust
# the dashboard demo preview (X-Demo-Mode header / ?demo=1) is honoured only when APP_ENV=development
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://artracker:artracker@localhost:5433/artracker?sslmode=disable
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# auth: SSO + sessions (values below are dummies: replace with real OAuth app credentials)
JWT_SECRET=dummy-jwt-secret-change-me
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# prod compose only
POSTGRES_USER=artracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=artracker
WEB_PORT=8088

# images published by .github/workflows/docker-publish.yml
DOCKER_USER=tayooooo
TAG=latest

# Session Replay Storage (Cloudflare R2 / S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
REPLAY_MAX_CHUNK_BYTES=5242880
# per-project replay request rate (chunk-url / chunk-ack / config), burst 2x; separate from INGEST_PROJECT_RPS
REPLAY_RATE_RPS=100
# development only: store replay chunks on disk when R2_BUCKET_NAME is empty (served via the signed API proxy)
REPLAY_LOCAL_DIR=

# Alerts (Telegram). Token from @BotFather; empty = incidents are recorded but nothing is sent
TELEGRAM_BOT_TOKEN=
# Bot API base URL (change only for a local Bot API server or tests)
TELEGRAM_API_BASE=https://api.telegram.org
# Run Telegram polling + alert evaluation on this instance; set false on every replica except one
ALERTS_WORKER=true
# Bot mode: "tenant" (default, SaaS) = each organisation connects its own bot in Settings;
# "shared" = one operator bot from TELEGRAM_BOT_TOKEN (self-hosting)
ALERTS_BOT_MODE=tenant
# Master key encrypting per-tenant bot tokens: standard base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32   (this file ships no value). Required in production when ALERTS_BOT_MODE=tenant.
ALERTS_MASTER_KEY=
# Alternative to ALERTS_MASTER_KEY: path to a file holding the key (Docker/Kubernetes secrets); set only one
ALERTS_MASTER_KEY_FILE=
# Label for the key, bound into the encryption (letters, digits, . _ -; max 32). Do not change it: rotation is
# not implemented, so a new value makes every stored bot token unreadable until each one is entered again
ALERTS_MASTER_KEY_ID=v1
# Alternative to TELEGRAM_BOT_TOKEN: path to a file holding the shared bot token; set only one
TELEGRAM_BOT_TOKEN_FILE=
