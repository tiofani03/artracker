# copy to .env and adjust
# the dashboard demo preview (X-Demo-Mode header / ?demo=1) is honoured only when APP_ENV=development
APP_ENV=development
PORT=8080
DATABASE_URL=postgres://artracker:artracker@localhost:5433/artracker?sslmode=disable
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=info
# Max Postgres connections in the API pool (default 25)
# DB_MAX_CONNS=25
# Run without a database (SKIP_DB=true, or DATABASE_URL=none / DATABASE_URL=memory). Only the in-memory artworks
# example routes work: ingest answers 401 (no keys can be checked) and auth, orgs, projects and replay answer 503.
# SKIP_DB=false

# Dev server: Vite reads PORT (above) to find the API, serves on WEB_DEV_PORT (default 5173) and proxies
# /api, /auth and /healthz to VITE_API_TARGET (default http://localhost:$PORT)
# WEB_DEV_PORT=5173
# VITE_API_TARGET=http://localhost:8080

# Ingest pipeline (POST /api/v1/ingest). Defaults shown; tune only under load.
# INGEST_WORKERS=4
# INGEST_QUEUE_SIZE=2048
# INGEST_BATCH_SIZE=500
# INGEST_FLUSH_INTERVAL_MS=250
# per-project request rate (burst 2x) and events per second
# INGEST_PROJECT_RPS=50
# INGEST_PROJECT_EVENTS_PER_SEC=1000
# seconds an API key lookup is cached per instance (a revoke or rotate clears the cache of the instance that
# handled it at once; other replicas can keep accepting the key for up to this long)
# INGEST_KEY_CACHE_TTL_SEC=60

# Analytics pipeline (POST /api/v1/events). Defaults shown.
# ANALYTICS_WORKERS=4
# ANALYTICS_QUEUE_SIZE=2048
# ANALYTICS_BATCH_SIZE=500
# ANALYTICS_FLUSH_INTERVAL_MS=250
# ANALYTICS_PROJECT_RPS=50
# ANALYTICS_PROJECT_EVENTS_PER_SEC=1000

# auth: SSO + sessions (values below are dummies: replace with real OAuth app credentials)
# JWT_SECRET is a dev placeholder: with APP_ENV=production the API refuses to start unless it is a random
# string of at least 32 characters (generate one with: openssl rand -hex 32)
JWT_SECRET=dummy-jwt-secret-change-me
PUBLIC_URL=http://localhost:5173
GOOGLE_CLIENT_ID=dummy-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dummy-google-client-secret

# prod compose only
POSTGRES_USER=artracker
POSTGRES_PASSWORD=change-me
POSTGRES_DB=artracker
WEB_PORT=8088
# host port for the published Postgres container (default 5432)
# DB_PORT=5432

# images published by .github/workflows/docker-publish.yml
DOCKER_USER=tayooooo
TAG=latest

# Session Replay Storage (Cloudflare R2 / S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_ACCESS_KEY_SECRET=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_REGION=auto
REPLAY_MAX_CHUNK_BYTES=5242880
# true (default): chunk uploads go through the signed API proxy (/api/v1/replay/upload-chunk);
# false: SDKs upload straight to R2 with presigned URLs (SDKs can still ask per request with "direct")
# REPLAY_PROXY_UPLOAD=true
# per-project replay request rate (chunk-url / chunk-ack / config), burst 2x; separate from INGEST_PROJECT_RPS (above)
REPLAY_RATE_RPS=100
# development only: store replay chunks on disk when R2_BUCKET_NAME is empty (served via the signed API proxy)
REPLAY_LOCAL_DIR=

# Alerts (Telegram). Token from @BotFather; empty = incidents are recorded but nothing is sent
TELEGRAM_BOT_TOKEN=
# Bot API base URL (change only for a local Bot API server or tests)
TELEGRAM_API_BASE=https://api.telegram.org
# Run Telegram polling + alert evaluation on this instance; set false on every replica except one
ALERTS_WORKER=true
# Bot mode: "tenant" (default, SaaS) = each organisation connects its own bot in Settings;
# "shared" = one operator bot from TELEGRAM_BOT_TOKEN (self-hosting)
ALERTS_BOT_MODE=tenant
# Master key encrypting per-tenant bot tokens: standard base64 of exactly 32 bytes.
# Generate with: openssl rand -base64 32   (this file ships no value). Required in production when ALERTS_BOT_MODE=tenant.
ALERTS_MASTER_KEY=
# Alternative to ALERTS_MASTER_KEY: path to a file holding the key (Docker/Kubernetes secrets); set only one
ALERTS_MASTER_KEY_FILE=
# Label for the key, bound into the encryption (letters, digits, . _ -; max 32). Do not change it: rotation is
# not implemented, so a new value makes every stored bot token unreadable until each one is entered again
ALERTS_MASTER_KEY_ID=v1
# Alternative to TELEGRAM_BOT_TOKEN: path to a file holding the shared bot token; set only one
TELEGRAM_BOT_TOKEN_FILE=
