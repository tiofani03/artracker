{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "artracker",
  "version": "0.1.0",
  "identifier": "id.art.tracker",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:app"
  },
  "app": {
    "windows": [
      {
        "title": "artracker",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 360,
        "minHeight": 520
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "appimage"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    },
    "shortDescription": "ARTracker",
    "category": "DeveloperTool"
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "artracker"
        ]
      },
      "mobile": [
        {
          "scheme": [
            "artracker"
          ],
          "host": "auth",
          "pathPrefix": [
            "/callback"
          ],
          "appLink": false
        }
      ]
    }
  }
}
