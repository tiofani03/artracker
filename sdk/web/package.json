{
  "name": "@artracker/web-sdk",
  "version": "0.1.0",
  "description": "ARTracker Web SDK: rrweb Session Replay recorder with client-side rage click & dead click frustration detection",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "peerDependencies": {
    "rrweb": ">=2.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "rrweb": "^2.2.0",
    "typescript": "~7.0.2"
  }
}
